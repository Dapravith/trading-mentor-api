# Copy to .env in the repository root. Never commit .env.
# Created through @BotFather and stored only on your own computer.
TELEGRAM_BOT_TOKEN='REPLACE_WITH_BOTFATHER_TOKEN'
# For public channels: @channel_username ; for private: -1001234567890
TELEGRAM_CHAT_ID='@REPLACE_WITH_CHANNEL_USERNAME'

# Turns on acknowledged sending to Telegram from the Java outbox.
TELEGRAM_DELIVERY_ENABLED=true
# Enable ONLY for a local connection test, then change to false.
TELEGRAM_TEST_ALERT_ENABLED=true

# Interactive bot commands (/help, /scan, /paper, ...) in a private chat with the bot.
# Comma-separated numeric Telegram user IDs; send the bot any message to learn yours.
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_ALLOWED_USER_IDS='REPLACE_WITH_YOUR_NUMERIC_USER_ID'

# Java market scan only, every 15 minutes while app is running
MARKET_SCAN_ENABLED=false
# Requires Hermes configured with browsing and local shell access
HERMES_NEWS_INTAKE_ENABLED=false
HERMES_NEWS_INGEST_KEY='REPLACE_WITH_OPENSSL_RAND_HEX_32'

# Optional, local-only recovery of individual FAILED outbox events.
# Generate a DIFFERENT operator key using: openssl rand -hex 32
ALERT_MANUAL_RETRY_ENABLED=false
ALERT_OPERATOR_KEY='REPLACE_WITH_AN_INDEPENDENT_64_HEX_SECRET'

# Binance Spot account monitoring: no trading or transfers.
# Use a NEW HMAC API key with "Enable Reading" ONLY and IP allowlisting.
# Never put these keys in GitHub Actions Secrets for a public-repo scheduler.
BINANCE_ACCOUNT_MONITOR_ENABLED=false
BINANCE_READ_API_KEY='REPLACE_WITH_BINANCE_HMAC_READ_KEY'
BINANCE_READ_API_SECRET='REPLACE_WITH_BINANCE_HMAC_READ_SECRET'

# Optional 9 AM Cambodia daily check; goes ONLY to your numeric PRIVATE Telegram DM.
BINANCE_ACCOUNT_DAILY_ENABLED=false
BINANCE_PRIVATE_CHAT_ID='REPLACE_WITH_PRIVATE_NUMERIC_CHAT_ID'

# Account digest: poll every 15 minutes after 09:00 Asia/Phnom_Penh.
# Missed 09:00 run is caught up later the same day (up to three attempts).
BINANCE_ACCOUNT_POLL_MS=900000
BINANCE_ACCOUNT_INITIAL_DELAY_MS=30000
